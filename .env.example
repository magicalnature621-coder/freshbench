# ---- Tavily (https://app.tavily.com - free tier: 1,000 credits/month) ----
TAVILY_API_KEY=tvly-...

# ---- LLM provider keys: add any you have. Bifrost routes to all of them. ----
# Groq and Gemini both have free tiers.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Bifrost gateway ----
BIFROST_URL=http://localhost:8080
# Virtual key that FreshBench uses to talk to Bifrost (written into bifrost/config.json)
BIFROST_VIRTUAL_KEY=sk-bf-freshbench

# Model that judges freshness (the same judge for every agent keeps the benchmark fair)
FRESHBENCH_JUDGE_MODEL=groq/llama-3.3-70b-versatile

# Set to 1 to run the whole pipeline offline against a fictional simulated world (no keys needed)
FRESHBENCH_SIMULATE=0
